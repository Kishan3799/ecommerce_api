# Simple SECRET_KEY - no special characters that confuse Docker
SECRET_KEY=mysupersecretkeyfordjangodocker12345abcdef
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://ecommerce_user:ecommerce_pass@db:5432/ecommerce_db

# Redis
REDIS_URL=redis://redis:6379/1